# Local development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use sqlite by default. Set to postgresql to use PostgreSQL locally.
DJANGO_DB=sqlite

# PostgreSQL settings (only needed when DJANGO_DB=postgresql)
POSTGRES_DB=recipes_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
